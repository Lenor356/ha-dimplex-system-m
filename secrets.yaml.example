# Vorlage. Diese Zeilen in die eigene /config/secrets.yaml übernehmen und
# ausfüllen. Die echte secrets.yaml gehört NICHT in ein öffentliches Repository.

# IP-Adresse des NWPM Touch (Modbus-TCP-Gateway der Wärmepumpe).
# Am Display zu finden unter den Netzwerkeinstellungen. Am besten im Router
# fest vergeben, damit sie sich nicht ändert.
dimplex_modbus_host: 192.168.x.x
